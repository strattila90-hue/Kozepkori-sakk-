rules_version = '2';
// Egyszerű szabályok a "rooms" gyűjteményhez: bárki olvashatja/létrehozhatja/frissítheti, törölni senki.
// Firebase konzol → Firestore Database → Szabályok → illeszd be → Közzététel.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['hostId', 'status', 'moves'])
                    && request.resource.data.moves.size() == 0;
      allow update: if request.resource.data.moves.size() <= 600;
      allow delete: if false;
    }
  }
}
